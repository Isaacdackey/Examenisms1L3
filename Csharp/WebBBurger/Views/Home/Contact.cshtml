@{
    ViewData["Title"] = "Contact - Brasil Burger";
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="text-center mb-4">
            <div style="width:56px; height:56px; background:var(--primary); color:var(--white); border-radius:16px; display:grid; place-items:center; margin:0 auto 0.75rem;"><i class="fas fa-phone-alt"></i></div>
            <h1 class="h3">Contactez-nous</h1>
            <p class="text-muted">Une question ? Une commande spéciale ? Nous sommes là 7j/7</p>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-4 text-center"><div style="width:48px; height:48px; background:var(--primary-50); color:var(--primary); border-radius:50%; display:grid; place-items:center; margin:0 auto 0.5rem;"><i class="fas fa-map-marker-alt"></i></div><strong>Dakar</strong><div class="text-muted" style="font-size:0.9rem;">Point E, Sénégal</div></div>
                    <div class="col-md-4 text-center"><div style="width:48px; height:48px; background:var(--success-light); color:var(--success); border-radius:50%; display:grid; place-items:center; margin:0 auto 0.5rem;"><i class="fas fa-phone"></i></div><strong>+221 77 123 45 67</strong><div class="text-muted" style="font-size:0.9rem;">10h — 23h</div></div>
                    <div class="col-md-4 text-center"><div style="width:48px; height:48px; background:var(--accent-gold-light); color:var(--accent-gold-dark); border-radius:50%; display:grid; place-items:center; margin:0 auto 0.5rem;"><i class="fas fa-envelope"></i></div><strong>contact@brasilburger.sn</strong><div class="text-muted" style="font-size:0.9rem;">Réponse rapide</div></div>
                </div>
                <form>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Nom</label><input class="form-control" placeholder="Votre nom" /></div>
                        <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" placeholder="vous@exemple.com" /></div>
                        <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="4" placeholder="Votre message..."></textarea></div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-4 btn-lg"><i class="fas fa-paper-plane"></i> Envoyer</button>
                </form>
            </div>
        </div>
    </div></div>
</div>
