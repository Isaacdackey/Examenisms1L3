@{
    ViewData["Title"] = "Confidentialité - Brasil Burger";
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3"><i class="fas fa-shield-alt me-2" style="color:var(--primary)"></i> Politique de confidentialité</h1>
                <p class="text-muted">Chez Brasil Burger, vos données sont précieuses. Nous collectons uniquement le nécessaire pour traiter vos commandes et améliorer votre expérience.</p>
                <h5 class="mt-4">Données collectées</h5><p class="text-muted">Nom, téléphone, adresse de livraison, historique de commandes.</p>
                <h5>Utilisation</h5><p class="text-muted">Traitement des commandes, livraison, support client. Aucune revente à des tiers.</p>
                <h5>Vos droits</h5><p class="text-muted">Accès, rectification, suppression sur demande à contact@brasilburger.sn</p>
                <div class="alert alert-info mt-4"><i class="fas fa-lock me-1"></i> Paiements chiffrés • Données hébergées de manière sécurisée</div>
            </div>
        </div>
    </div></div>
</div>
