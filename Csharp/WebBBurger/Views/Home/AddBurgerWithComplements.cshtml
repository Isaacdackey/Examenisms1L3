@using WebBBurger.Models.ViewModels
@model WebBBurger.Models.ViewModels.BurgerDetailsViewModel
@{
    var libelle = Model?.Libelle ?? "Burger";
    var prix = Model?.Prix ?? 0;
    var description = Model?.Description ?? "";
    var imageUrl = Model?.ImageUrl ?? "";
    var typeBurger = Model?.TypeBurger;
    var calories = Model?.Calories;
    var tempsPreparation = Model?.TempsPreparation;
    var boissons = Model?.Boissons ?? new List<ProductViewModel>();
    var frites = Model?.Frites ?? new List<ProductViewModel>();
    
    ViewData["Title"] = $"{libelle} - Brasil Burger";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                @if (!string.IsNullOrEmpty(imageUrl))
                {
                    <img src="@imageUrl" class="card-img-top" alt="@libelle" 
                         style="height: 400px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                         style="height: 400px;">
                        <i class="fas fa-hamburger fa-5x text-muted"></i>
                    </div>
                }
                <div class="card-body">
                    <h1 class="card-title">@libelle</h1>
                    <h3 class="text-primary">@prix.ToString("C0") FCFA</h3>
                    @if (!string.IsNullOrEmpty(description))
                    {
                        <p class="card-text">@description</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4">Personnalisez votre burger</h4>
                    
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        </div>
                    }
                    
                    
                    @if (!string.IsNullOrEmpty(typeBurger) || calories.HasValue || tempsPreparation.HasValue)
                    {
                        <div class="mb-4">
                            <h5>Informations :</h5>
                            <ul class="list-unstyled">
                                @if (!string.IsNullOrEmpty(typeBurger))
                                {
                                    <li><i class="fas fa-hamburger"></i> Type : @typeBurger</li>
                                }
                                @if (calories.HasValue)
                                {
                                    <li><i class="fas fa-fire"></i> Calories : @calories.Value</li>
                                }
                                @if (tempsPreparation.HasValue)
                                {
                                    <li><i class="fas fa-clock"></i> Préparation : @tempsPreparation.Value min</li>
                                }
                            </ul>
                        </div>
                    }

                    
                    @if (Model != null)
                    {
                        <form method="post" asp-action="AddBurgerWithComplements" id="burgerForm">
                            @Html.AntiForgeryToken()
                            
                            <!-- Champs cachés pour les données principales -->
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="Libelle" />
                            <input type="hidden" asp-for="Prix" />
                            <input type="hidden" asp-for="Description" />
                            <input type="hidden" asp-for="ImageUrl" />
                            <input type="hidden" asp-for="TypeBurger" />
                            <input type="hidden" asp-for="Calories" />
                            <input type="hidden" asp-for="TempsPreparation" />
                            
                            <!-- Champs cachés pour les listes (CRITIQUE) -->
                            @for (int i = 0; i < Model.Boissons?.Count; i++)
                            {
                                <input type="hidden" asp-for="Boissons[i].Id" />
                                <input type="hidden" asp-for="Boissons[i].Libelle" />
                                <input type="hidden" asp-for="Boissons[i].Prix" />
                                <input type="hidden" asp-for="Boissons[i].Description" />
                                <input type="hidden" asp-for="Boissons[i].ImageUrl" />
                            }
                            
                            @for (int i = 0; i < Model.Frites?.Count; i++)
                            {
                                <input type="hidden" asp-for="Frites[i].Id" />
                                <input type="hidden" asp-for="Frites[i].Libelle" />
                                <input type="hidden" asp-for="Frites[i].Prix" />
                                <input type="hidden" asp-for="Frites[i].Description" />
                                <input type="hidden" asp-for="Frites[i].ImageUrl" />
                            }

                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Choisissez une boisson :</label>
                                <select asp-for="SelectedBoissonId" class="form-select" id="boissonSelect">
                                    <option value="">Sans boisson</option>
                                    @if (boissons.Any())
                                    {
                                        foreach (var boisson in boissons)
                                        {
                                            <option value="@boisson.Id" data-price="@boisson.Prix">
                                                @boisson.Libelle (+@boisson.Prix.ToString("C0"))
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SelectedBoissonId" class="text-danger"></span>
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Choisissez des frites :</label>
                                <select asp-for="SelectedFritesId" class="form-select" id="fritesSelect">
                                    <option value="">Sans frites</option>
                                    @if (frites.Any())
                                    {
                                        foreach (var frite in frites)
                                        {
                                            <option value="@frite.Id" data-price="@frite.Prix">
                                                @frite.Libelle (+@frite.Prix.ToString("C0"))
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SelectedFritesId" class="text-danger"></span>
                            </div>

                            
                            <div class="mb-4">
                                <label asp-for="Quantity" class="form-label fw-bold">Quantité :</label>
                                <div class="input-group" style="max-width: 150px;">
                                    <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(-1)">-</button>
                                    <input asp-for="Quantity" class="form-control text-center" 
                                           min="1" max="10" id="quantityInput" readonly />
                                    <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(1)">+</button>
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            
                            <div class="card bg-light mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">Récapitulatif</h5>
                                    <ul class="list-unstyled mb-0">
                                        <li>Burger : @prix.ToString("C0") × <span id="displayQty">1</span></li>
                                        <li id="boissonLine" style="display: none;">
                                            Boisson : +<span id="boissonPrice">0</span> × <span id="boissonQty">1</span>
                                        </li>
                                        <li id="fritesLine" style="display: none;">
                                            Frites : +<span id="fritesPrice">0</span> × <span id="fritesQty">1</span>
                                        </li>
                                        <li class="mt-2 pt-2 border-top">
                                            <strong>Total : <span class="text-primary" id="totalPrice">@prix.ToString("C0")</span> FCFA</strong>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg py-3">
                                    <i class="fas fa-cart-plus me-2"></i>Ajouter au panier
                                </button>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Retour au catalogue
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle"></i> Erreur</h5>
                            <p>Les données du burger ne sont pas disponibles.</p>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                                <i class="fas fa-arrow-left me-2"></i>Retour au catalogue
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            console.log("Page AddBurgerWithComplements chargée");
            
            
            @if (Model != null)
            {
                @:console.log("Boissons disponibles:", @boissons.Count);
                @:console.log("Frites disponibles:", @frites.Count);
            }
            else
            {
                @:console.log("Modèle non disponible");
            }
            
            
            function calculateTotal() {
                let burgerPrice = @prix;
                let quantity = parseInt($('#quantityInput').val()) || 1;
                let boissonPrice = 0;
                let fritesPrice = 0;
                
                
                $('#displayQty').text(quantity);
                
                
                let boissonSelect = $('#boissonSelect');
                if (boissonSelect.length > 0) {
                    let selectedBoisson = boissonSelect.find(':selected');
                    if (selectedBoisson.val() !== '') {
                        boissonPrice = parseFloat(selectedBoisson.data('price')) || 0;
                        $('#boissonLine').show();
                        $('#boissonPrice').text(boissonPrice.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' '));
                        $('#boissonQty').text(quantity);
                    } else {
                        $('#boissonLine').hide();
                    }
                }
                
                
                let fritesSelect = $('#fritesSelect');
                if (fritesSelect.length > 0) {
                    let selectedFrites = fritesSelect.find(':selected');
                    if (selectedFrites.val() !== '') {
                        fritesPrice = parseFloat(selectedFrites.data('price')) || 0;
                        $('#fritesLine').show();
                        $('#fritesPrice').text(fritesPrice.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' '));
                        $('#fritesQty').text(quantity);
                    } else {
                        $('#fritesLine').hide();
                    }
                }
                
                let total = (burgerPrice + boissonPrice + fritesPrice) * quantity;
                

                $('#totalPrice').text(total.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' FCFA');
                
                console.log('Total calculé:', total);
                return total;
            }
            
            
            window.changeQuantity = function(delta) {
                let input = $('#quantityInput');
                let current = parseInt(input.val()) || 1;
                let newValue = current + delta;
                
                if (newValue >= 1 && newValue <= 10) {
                    input.val(newValue);
                    calculateTotal();
                }
            };
            
            
            $('#boissonSelect, #fritesSelect').on('change', calculateTotal);
            
            calculateTotal();
            
            $('#burgerForm').on('submit', function(e) {
                console.log('Soumission du formulaire...');
                
                let quantity = $('#quantityInput').val();
                if (quantity < 1 || quantity > 10) {
                    alert('La quantité doit être entre 1 et 10');
                    e.preventDefault();
                    return false;
                }
                
                $('button[type="submit"]').html('<i class="fas fa-spinner fa-spin me-2"></i>Traitement...');
                $('button[type="submit"]').prop('disabled', true);
                
                return true;
            });
        });
    </script>
}