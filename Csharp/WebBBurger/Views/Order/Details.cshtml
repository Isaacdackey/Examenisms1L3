@model WebBBurger.Models.Commande
@{
    ViewData["Title"] = $"Commande #{Model.Id} - Brasil Burger";
}
<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary btn-sm" style="border-radius:999px;"><i class="fas fa-arrow-left"></i></a>
        <h1 class="h4 mb-0">Commande <span style="color:var(--primary)">#@(Model.Numero ?? "BB-" + Model.Id)</span></h1>
        <span class="badge" style="@GetStatusStyle(Model.Statut) border:1px solid rgba(0,0,0,0.06); border-radius:999px; padding:0.5rem 0.85rem; font-weight:700;">@Model.StatutDisplay</span>
        <span class="ms-auto fw-bold">@Model.MontantTotal.ToString("N0") FCFA</span>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header"><i class="fas fa-list me-2" style="color:var(--primary)"></i> Articles</div>
                <div class="card-body p-0">
                    @if (Model.LigneCommandes != null && Model.LigneCommandes.Any()){
                        foreach(var l in Model.LigneCommandes){
                        <div class="d-flex justify-content-between p-3" style="border-bottom:1px solid var(--gray-100);">
                            <div><strong>@l.Produit?.Libelle</strong> <span class="text-muted">x @l.Quantite</span><div class="text-muted" style="font-size:0.85rem;">@l.Produit?.Description</div></div>
                            <strong>@((l.PrixUnitaire * l.Quantite).ToString("N0")) FCFA</strong>
                        </div>
                    }} else {
                        <div class="p-4 text-muted text-center">Aucune ligne</div>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-header"><i class="fas fa-truck me-2" style="color:var(--primary)"></i> Livraison</div>
                <div class="card-body" style="font-size:0.92rem;">
                    <p class="mb-1"><i class="fas fa-map-marker-alt me-2" style="color:var(--primary)"></i> @Model.Adresse</p>
                    <p class="mb-1"><i class="fas fa-box me-2" style="color:var(--primary)"></i> Type : @Model.TypeRetrait</p>
                    @if (Model.Zone != null){ <p class="mb-1"><i class="fas fa-map me-2"></i> Zone : @Model.Zone.Nom (+@Model.Zone.PrixLivraison.ToString("N0") FCFA)</p> }
                    @if (!string.IsNullOrEmpty(Model.Notes)){ <p class="mb-1"><i class="fas fa-sticky-note me-2"></i> Notes : @Model.Notes</p> }
                    <p class="mb-0"><i class="fas fa-credit-card me-2" style="color:var(--primary)"></i> Paiement : @Model.MoyenPaiement</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="cart-summary">
                <h6 class="fw-bold mb-3">Recapitulatif</h6>
                <div class="summary-line"><span>Sous-total</span><span>@Model.MontantTotal.ToString("N0") FCFA</span></div>
                <div class="summary-line total"><span>Total paye</span><span>@Model.MontantTotal.ToString("N0") FCFA</span></div>
                <div class="d-grid gap-2 mt-3">
                    @if (Model.Statut != "TERMINEE" && Model.Statut != "ANNULEE" && Model.Statut != "LIVREE" && Model.Statut != "PAYE"){
                        <a asp-action="Payment" asp-route-id="@Model.Id" asp-controller="Order" class="btn btn-primary"><i class="fas fa-credit-card"></i> Payer</a>
                    }
                    @if (CanCancel(Model.Statut)){
                        <form asp-action="Cancel" asp-controller="Order" method="post" class="d-grid">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn" style="background:var(--danger-light); color:var(--danger); border:1.5px solid #fecaca; border-radius:999px; font-weight:700;" onclick="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?')"><i class="fas fa-times me-1"></i> Annuler la commande</button>
                        </form>
                    }
                    <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary" style="border-radius:999px;">Historique</a>
                </div>
            </div>
        </div>
    </div>
</div>
@functions{
    string GetStatusStyle(string s) => s switch{
        "EN_ATTENTE" => "background:var(--primary-50); color:var(--primary-dark);",
        "VALIDEE" => "background:#eff6ff; color:#1d4ed8;",
        "EN_PREPARATION" => "background:#eff6ff; color:#1d4ed8;",
        "PRETE" => "background:var(--accent-gold-light); color:#92400e;",
        "EN_LIVRAISON" => "background:#eff6ff; color:#1d4ed8;",
        "LIVREE" => "background:var(--success-light); color:#166534;",
        "TERMINEE" => "background:var(--success-light); color:#166534;",
        "PAYE" => "background:var(--success-light); color:#166534;",
        "ANNULEE" => "background:var(--danger-light); color:#991b1b;",
        _ => "background:var(--gray-100); color:var(--gray-700);"
    };
    bool CanCancel(string s) => s == "EN_ATTENTE" || s == "VALIDEE";
}

