@model WebBBurger.Models.ViewModels.SimulatePaymentViewModel
@{
    ViewData["Title"] = "Simulation de paiement - Brasil Burger";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Simulation de Paiement</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> 
                        Mode simulation activé. En production, vous seriez redirigé vers une passerelle de paiement.
                    </div>
                    
                    <div class="mb-4">
                        <h5>Commande @Model.OrderNumber</h5>
                        <p><strong>Montant :</strong> @Model.Total.ToString("C0") FCFA</p>
                        <p><strong>Méthode :</strong> @(Model.PaymentMethod == "EN_LIGNE" ? "Paiement en ligne" : "Paiement en espèces")</p>
                    </div>
                    
                    <form method="post" action="@Url.Action("SimulatePaymentConfirmed", "Order")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="paymentMethod" value="@Model.PaymentMethod" />
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle"></i> Simuler un paiement réussi
                            </button>
                            
                            <a href="@Url.Action("Details", "Order", new { id = Model.OrderId })" 
                               class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Retour aux détails
                            </a>
                            
                            <a href="@Url.Action("PaymentFailed", "Order", new { orderId = Model.OrderId })" 
                               class="btn btn-danger">
                                <i class="fas fa-times-circle"></i> Simuler un échec de paiement
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>