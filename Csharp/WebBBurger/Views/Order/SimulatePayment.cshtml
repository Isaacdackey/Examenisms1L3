@model WebBBurger.Models.ViewModels.SimulatePaymentViewModel
@{
    ViewData["Title"] = "Paiement sécurisé - Brasil Burger";
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-md-6">
        <div class="card overflow-hidden">
            <div class="card-header text-center" style="background:var(--neutral-900); color:var(--white); padding:1.5rem;">
                <div style="width:48px; height:48px; background:var(--primary); border-radius:50%; display:grid; place-items:center; margin:0 auto 0.5rem;"><i class="fas fa-lock"></i></div>
                <h4 class="mb-1" style="color:var(--white)">Paiement sécurisé</h4>
                <p class="mb-0" style="color:rgba(255,255,255,0.7); font-size:0.9rem;">Simulation • @Model.MoyenPaiement • @Model.Montant.ToString("N0") FCFA</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="SimulatePayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CommandeId" />
                    <input type="hidden" asp-for="MoyenPaiement" />
                    <input type="hidden" asp-for="Montant" />
                    <div class="alert alert-info"><i class="fas fa-info-circle me-1"></i> Ceci est une simulation. Aucun vrai débit ne sera effectué.</div>
                    <div class="mb-3"><label asp-for="Telephone" class="form-label">Numéro @Model.MoyenPaiement</label><input asp-for="Telephone" class="form-control" placeholder="77 123 45 67" /><span asp-validation-for="Telephone" class="text-danger small"></span></div>
                    <div class="mb-4"><label asp-for="Code" class="form-label">Code de confirmation (optionnel)</label><input asp-for="Code" class="form-control" placeholder="0000" /></div>
                    <div class="d-grid gap-2">
                        <button type="submit" name="action" value="success" class="btn btn-success btn-lg"><i class="fas fa-check-circle"></i> Simuler succès</button>
                        <button type="submit" name="action" value="fail" class="btn btn-outline-secondary" style="border-radius:999px;"><i class="fas fa-times"></i> Simuler échec</button>
                    </div>
                </form>
            </div>
        </div>
    </div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
