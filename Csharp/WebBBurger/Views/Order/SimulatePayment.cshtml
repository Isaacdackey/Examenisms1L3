@model WebBBurger.Models.ViewModels.SimulatePaymentViewModel
@{
    ViewData["Title"] = "Simulation de paiement - Brasil Burger";
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-md-6">
        <div class="card overflow-hidden">
            <div class="card-header text-center" style="background:var(--neutral-900); color:var(--white); padding:1.5rem;">
                <div style="width:48px; height:48px; background:var(--primary); border-radius:50%; display:grid; place-items:center; margin:0 auto 0.5rem;"><i class="fas fa-lock"></i></div>
                <h4 class="mb-1" style="color:var(--white)">Simulation de Paiement</h4>
                <p class="mb-0" style="color:rgba(255,255,255,0.7); font-size:0.9rem;">Commande @Model.OrderNumber • @Model.Total.ToString("N0") FCFA</p>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info"><i class="fas fa-info-circle"></i> Mode simulation active. En production, redirection vers passerelle.</div>
                <div class="mb-4">
                    <h5>Commande @Model.OrderNumber</h5>
                    <p><strong>Montant :</strong> @Model.Total.ToString("N0") FCFA</p>
                    <p><strong>Methode :</strong> @(Model.PaymentMethod == "EN_LIGNE" ? "Paiement en ligne" : Model.PaymentMethod)</p>
                </div>
                <form method="post" action="@Url.Action("SimulatePaymentConfirmed", "Order")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <input type="hidden" name="paymentMethod" value="@Model.PaymentMethod" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg"><i class="fas fa-check-circle"></i> Simuler un paiement reussi</button>
                        <a href="@Url.Action("Details", "Order", new { id = Model.OrderId })" class="btn btn-outline-secondary" style="border-radius:999px;"><i class="fas fa-times"></i> Retour aux details</a>
                        <a href="@Url.Action("PaymentFailed", "Order", new { orderId = Model.OrderId })" class="btn btn-danger"><i class="fas fa-times-circle"></i> Simuler un echec</a>
                    </div>
                </form>
            </div>
        </div>
    </div></div>
</div>
