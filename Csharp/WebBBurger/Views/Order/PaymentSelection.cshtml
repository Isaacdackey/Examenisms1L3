@model WebBBurger.Models.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Choix du paiement - Brasil Burger";
}
<div class="container py-4">
    <div class="stepper mb-4"><div class="step completed">Panier</div><div class="step completed">Livraison</div><div class="step active">Paiement</div></div>
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2"><i class="fas fa-credit-card" style="color:var(--primary)"></i> <strong>Choisir un moyen de paiement</strong></div>
            <div class="card-body">
                <form asp-action="ProcessPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CommandeId" />
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3"><label class="payment-option w-100 h-100 text-center" style="flex-direction:column;"><input type="radio" asp-for="MoyenPaiement" value="WAVE" id="psWave" style="position:absolute; opacity:0;"><div class="payment-icon wave mx-auto">W</div><span class="fw-bold">Wave</span><small class="text-muted d-block">Mobile money</small></label></div>
                        <div class="col-6 col-md-3"><label class="payment-option w-100 h-100 text-center" style="flex-direction:column;"><input type="radio" asp-for="MoyenPaiement" value="ORANGE_MONEY" id="psOM" style="position:absolute; opacity:0;"><div class="payment-icon orange mx-auto">OM</div><span class="fw-bold">Orange Money</span></label></div>
                        <div class="col-6 col-md-3"><label class="payment-option w-100 h-100 text-center" style="flex-direction:column;"><input type="radio" asp-for="MoyenPaiement" value="CARTE" id="psCarte" style="position:absolute; opacity:0;"><div class="payment-icon card mx-auto"><i class="fas fa-credit-card"></i></div><span class="fw-bold">Carte</span></label></div>
                        <div class="col-6 col-md-3"><label class="payment-option w-100 h-100 text-center" style="flex-direction:column;"><input type="radio" asp-for="MoyenPaiement" value="ESPECES" id="psEspeces" style="position:absolute; opacity:0;"><div class="payment-icon cash mx-auto"><i class="fas fa-money-bill-wave"></i></div><span class="fw-bold">Espèces</span></label></div>
                    </div>
                    <span asp-validation-for="MoyenPaiement" class="text-danger"></span>
                    <div class="cart-summary mt-4" style="position:static;">
                        <div class="d-flex justify-content-between mb-2"><span>Commande #@Model.CommandeId</span><strong>@Model.Montant.ToString("N0") FCFA</strong></div>
                        <div class="d-grid"><button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-lock"></i> Payer maintenant</button></div>
                        <a href="@Url.Action("Details", "Order", new { id = Model.CommandeId })" class="btn btn-outline-secondary w-100 mt-2" style="border-radius:999px;">← Retour</a>
                    </div>
                </form>
            </div>
        </div>
    </div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" />
<script>$(function(){$(''input[name="MoyenPaiement"]'').on(''change'', function(){ $(''.payment-option'').removeClass(''selected''); $(this).closest(''.payment-option'').addClass(''selected''); });});</script> }
