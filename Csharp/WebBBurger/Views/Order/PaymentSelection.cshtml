@model WebBBurger.Models.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Choix du paiement - Brasil Burger";
}
<div class="container py-4">
    <div class="stepper mb-4"><div class="step completed">Panier</div><div class="step completed">Livraison</div><div class="step active">Paiement</div></div>
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2"><i class="fas fa-credit-card" style="color:var(--primary)"></i> <strong>Choisir un moyen de paiement</strong></div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <h5><i class="fas fa-receipt"></i> Commande #@Model.NumeroCommande</h5>
                    <p class="mb-0">Montant a payer : <strong>@Model.Total.ToString("N0") FCFA</strong></p>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <div class="card-body">
                                <div class="mb-3"><i class="fas fa-mobile-alt fa-3x" style="color:var(--success)"></i></div>
                                <h5>Wave</h5><p class="text-muted small">Paiement mobile rapide</p>
                                <a href="@Url.Action("SimulatePayment", "Order", new { orderId = Model.CommandeId })" class="btn btn-outline-success"><i class="fas fa-hand-holding-usd"></i> Payer Par Wave</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <div class="card-body">
                                <div class="mb-3"><i class="fas fa-mobile-alt fa-3x" style="color:var(--warning)"></i></div>
                                <h5>Orange Money</h5><p class="text-muted small">Via Orange Money</p>
                                <a href="@Url.Action("SimulatePayment", "Order", new { orderId = Model.CommandeId })" class="btn btn-outline-success"><i class="fas fa-hand-holding-usd"></i> Payer par Orange Money</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <div class="card-body">
                                <div class="mb-3"><i class="fas fa-credit-card fa-3x text-primary"></i></div>
                                <h5>Carte Bancaire</h5><p class="text-muted small">Paiement securise</p>
                                <a href="@Url.Action("SimulatePayment", "Order", new { orderId = Model.CommandeId })" class="btn btn-outline-success"><i class="fas fa-hand-holding-usd"></i> Payer Par Carte</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <div class="card-body">
                                <div class="mb-3"><i class="fas fa-money-bill-wave fa-3x text-success"></i></div>
                                <h5>Especes</h5><p class="text-muted small">A la livraison / sur place</p>
                                <a href="@Url.Action("SimulatePayment", "Order", new { orderId = Model.CommandeId })" class="btn btn-outline-success"><i class="fas fa-hand-holding-usd"></i> Simuler paiement especes</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                    <a href="@Url.Action("Details", "Order", new { id = Model.CommandeId })" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Retour aux details</a>
                </div>
            </div>
        </div>
    </div></div>
</div>
