@model WebBBurger.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Validation de commande - Brasil Burger";
}
<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:44px; height:44px; background:var(--primary); color:var(--white); border-radius:12px; display:grid; place-items:center;"><i class="fas fa-clipboard-check"></i></div>
        <div>
            <h1 class="h4 mb-0" style="letter-spacing:-0.02em;">Validation de commande</h1>
            <p class="text-muted mb-0" style="font-size:0.88rem;">Plus qu'une étape avant de vous régaler</p>
        </div>
        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary ms-auto d-none d-md-inline-flex" style="border-radius:999px;">← Panier</a>
    </div>

    
    <div class="stepper mb-4" role="navigation" aria-label="Étapes de commande">
        <div class="step completed">Panier</div>
        <div class="step active">Livraison</div>
        <div class="step">Paiement</div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    }

    <form asp-action="Checkout" method="post">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header"><i class="fas fa-truck me-2" style="color:var(--primary)"></i> Informations de livraison</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Adresse" class="form-label">Adresse *</label>
                            <input asp-for="Adresse" class="form-control" placeholder="Ex: Point E, Rue 12, Dakar" />
                            <span asp-validation-for="Adresse" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mode de retrait *</label>
                            <div class="d-flex flex-wrap gap-2">
                                <label class="payment-option flex-fill" style="cursor:pointer; padding:0.85rem;">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="SUR_PLACE" id="typeSurPlace">
                                    <span class="ms-2"><i class="fas fa-store me-1"></i> Sur place</span>
                                </label>
                                <label class="payment-option flex-fill" style="cursor:pointer; padding:0.85rem;">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="A_EMPORTER" id="typeEmporter">
                                    <span class="ms-2"><i class="fas fa-shopping-bag me-1"></i> À emporter</span>
                                </label>
                                <label class="payment-option flex-fill" style="cursor:pointer; padding:0.85rem;">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="LIVRAISON" id="typeLivraison">
                                    <span class="ms-2"><i class="fas fa-motorcycle me-1"></i> Livraison</span>
                                </label>
                            </div>
                            <span asp-validation-for="TypeRetrait" class="text-danger"></span>
                        </div>
                        <div id="zonesLivraison" class="mb-3" style="display:none;">
                            <label asp-for="ZoneId" class="form-label">Zone de livraison *</label>
                            <select asp-for="ZoneId" class="form-select">
                                <option value="">Sélectionnez une zone</option>
                                @foreach (var zone in Model.Zones)
                                {
                                    <option value="@zone.Id" data-prix="@zone.PrixLivraison">@zone.Nom - +@zone.PrixLivraison.ToString("N0") FCFA</option>
                                }
                            </select>
                            <span asp-validation-for="ZoneId" class="text-danger"></span>
                            <small class="text-muted"><i class="fas fa-info-circle me-1"></i> Frais selon votre zone</small>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Notes" class="form-label">Notes pour le restaurant</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Allergies, étage, code porte..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><i class="fas fa-credit-card me-2" style="color:var(--primary)"></i> Moyen de paiement</div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <label class="payment-option w-100 h-100" for="paiementEspeces" style="flex-direction:column; text-align:center; justify-content:center;">
                                    <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="ESPECES" id="paiementEspeces" style="position:absolute; opacity:0;">
                                    <div class="payment-icon cash mx-auto"><i class="fas fa-money-bill-wave"></i></div>
                                    <span style="font-weight:700; font-size:0.9rem;">Espèces</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="payment-option w-100 h-100" for="paiementCarte" style="flex-direction:column; text-align:center; justify-content:center;">
                                    <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="CARTE" id="paiementCarte" style="position:absolute; opacity:0;">
                                    <div class="payment-icon card mx-auto"><i class="fas fa-credit-card"></i></div>
                                    <span style="font-weight:700; font-size:0.9rem;">Carte</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="payment-option w-100 h-100" for="paiementWave" style="flex-direction:column; text-align:center; justify-content:center;">
                                    <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="WAVE" id="paiementWave" style="position:absolute; opacity:0;">
                                    <div class="payment-icon wave mx-auto">W</div>
                                    <span style="font-weight:700; font-size:0.9rem;">Wave</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="payment-option w-100 h-100" for="paiementOrange" style="flex-direction:column; text-align:center; justify-content:center;">
                                    <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="ORANGE_MONEY" id="paiementOrange" style="position:absolute; opacity:0;">
                                    <div class="payment-icon orange mx-auto" style="font-size:0.85rem;">OM</div>
                                    <span style="font-weight:700; font-size:0.9rem;">Orange Money</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="MoyenPaiement" class="text-danger d-block mt-2"></span>
                        <div class="alert alert-info mt-3 mb-0 py-2" style="font-size:0.88rem;"><i class="fas fa-info-circle me-1"></i> Paiement en ligne : redirection sécurisée après validation.</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary">
                    <h5 class="mb-3"><i class="fas fa-receipt me-2" style="color:var(--primary)"></i> Votre commande</h5>
                    @if (Model.Panier?.Items != null)
                    {
                        <div class="mb-3">
                            @foreach (var item in Model.Panier.Items)
                            {
                                <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;">
                                    <span class="text-truncate me-2" style="max-width:160px;">@item.Libelle × @item.Quantite</span>
                                    <strong>@((item.Prix * item.Quantite).ToString("N0")) FCFA</strong>
                                </div>
                                <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].ProductId" value="@item.ProductId" />
                                <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].Quantite" value="@item.Quantite" />
                                <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].Prix" value="@item.Prix" />
                            }
                        </div>
                    }
                    <div class="summary-line"><span>Sous-total</span><span>@Model.TotalCommande.ToString("N0") FCFA</span></div>
                    <div class="summary-line"><span>Livraison</span><span id="fraisLivraisonText">0 FCFA</span></div>
                    <div class="summary-line total"><span>Total à payer</span><span id="totalAPayerText">@Model.TotalCommande.ToString("N0") FCFA</span></div>
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg"><i class="fas fa-check-circle"></i> Valider la commande</button>
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary" style="border-radius:999px;">← Retour panier</a>
                    </div>
                    <p class="text-muted text-center mt-3 mb-0" style="font-size:0.82rem;"><i class="fas fa-lock me-1"></i> Données chiffrées et sécurisées</p>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function(){
            function toggleZones(){
                var isLiv = $('input[name="TypeRetrait"]:checked').val() === 'LIVRAISON';
                $('#zonesLivraison').toggle(isLiv);
                if(isLiv) { $('#ZoneId').prop('required', true); updateFrais(); } else { $('#ZoneId').prop('required', false); $('#fraisLivraisonText').text('0 FCFA'); updateTotal(); }
                $('label.payment-option').removeClass('selected');
                $('input[name="TypeRetrait"]:checked').closest('label').addClass('selected');
            }
            function updateFrais(){
                var frais=0; var v=$('#ZoneId').val(); if(v){ frais=parseFloat($('#ZoneId option:selected').data('prix'))||0; }
                $('#fraisLivraisonText').text(frais.toLocaleString('fr-FR')+' FCFA'); updateTotal();
            }
            function updateTotal(){
                var sous=@Model.TotalCommande; var frais=parseFloat($('#fraisLivraisonText').text().replace(/[^0-9]/g,''))||0; $('#totalAPayerText').text((sous+frais).toLocaleString('fr-FR')+' FCFA');
            }
            $('input[name="TypeRetrait"]').on('change', toggleZones);
            $('#ZoneId').on('change', updateFrais);
            $('input[name="MoyenPaiement"]').on('change', function(){ $('.payment-option').removeClass('selected'); $('input[name="MoyenPaiement"]:checked').closest('.payment-option').addClass('selected'); });
            toggleZones(); updateTotal();
            if($('input[name="MoyenPaiement"]:checked').length) $('input[name="MoyenPaiement"]:checked').trigger('change');
        });
    </script>
}

