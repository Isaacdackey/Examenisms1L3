@model WebBBurger.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Validation de commande - Brasil Burger";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-clipboard-check"></i> Validation de commande</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <h5>Veuillez corriger les erreurs suivantes :</h5>
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    }

    <form asp-action="Checkout" method="post">
        <div class="row">
            
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-truck"></i> Informations de livraison</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Adresse" class="form-label">Adresse *</label>
                                <input asp-for="Adresse" class="form-control" />
                                <span asp-validation-for="Adresse" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mode de retrait *</label>
                            <div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="SUR_PLACE" id="typeSurPlace">
                                    <label class="form-check-label" for="typeSurPlace">
                                        <i class="fas fa-store"></i> Sur place
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="A_EMPORTER" id="typeEmporter">
                                    <label class="form-check-label" for="typeEmporter">
                                        <i class="fas fa-bag-shopping"></i> À emporter
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TypeRetrait" value="LIVRAISON" id="typeLivraison">
                                    <label class="form-check-label" for="typeLivraison">
                                        <i class="fas fa-motorcycle"></i> Livraison
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="TypeRetrait" class="text-danger"></span>
                        </div>

                        
                        <div id="zonesLivraison" class="mb-3" style="display: none;">
                            <label asp-for="ZoneId" class="form-label">Zone de livraison *</label>
                            <select asp-for="ZoneId" class="form-select">
                                <option value="">Sélectionnez une zone</option>
                                @foreach (var zone in Model.Zones)
                                {
                                    <option value="@zone.Id" data-prix="@zone.PrixLivraison">
                                        @zone.Nom - +@zone.PrixLivraison.ToString("C0") FCFA
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ZoneId" class="text-danger"></span>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> 
                                Les frais de livraison dépendent de votre zone.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes pour le restaurant</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" 
                                      placeholder="Instructions spéciales, allergies, etc."></textarea>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-credit-card"></i> Moyen de paiement</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Sélectionnez votre moyen de paiement *</label>
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="ESPECES" id="paiementEspeces">
                                        <label class="form-check-label" for="paiementEspeces">
                                            <i class="fas fa-money-bill-wave"></i> Espèces
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="CARTE" id="paiementCarte">
                                        <label class="form-check-label" for="paiementCarte">
                                            <i class="fas fa-credit-card"></i> Carte
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="WAVE" id="paiementWave">
                                        <label class="form-check-label" for="paiementWave">
                                            <i class="fas fa-mobile-alt"></i> Wave
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="MoyenPaiement" value="ORANGE_MONEY" id="paiementOrange">
                                        <label class="form-check-label" for="paiementOrange">
                                            <i class="fas fa-mobile-alt"></i> Orange Money
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="MoyenPaiement" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            Pour les paiements en ligne (Wave/Orange Money), vous serez redirigé vers 
                            la plateforme de paiement après validation de la commande.
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-md-4">
                <div class="card sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-receipt"></i> Récapitulatif</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="card-subtitle mb-3">Votre commande</h6>
                        
                        
                        @if (Model.Panier?.Items != null)
                        {
                            <div class="mb-3">
                                @foreach (var item in Model.Panier.Items)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <div>
                                            
                                            <small>@item.Libelle × @item.Quantite</small>
                                        </div>
                                        
                                        <small>@((item.Prix * item.Quantite).ToString("C0"))</small>
                                    </div>
                                    
                                    
                                    <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].ProductId" value="@item.ProductId" />
                                    <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].Quantite" value="@item.Quantite" />
                                    <input type="hidden" name="items[@Model.Panier.Items.ToList().IndexOf(item)].Prix" value="@item.Prix" />
                                }
                            </div>
                        }

                        <hr>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total :</span>
                            <span>@Model.TotalCommande.ToString("C0") FCFA</span>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Frais de livraison :</span>
                            <span id="fraisLivraisonText">0 FCFA</span>
                        </div>
                        
                        <hr>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total à payer :</strong>
                            <strong class="h5" id="totalAPayerText">@Model.TotalCommande.ToString("C0") FCFA</strong>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle"></i> Valider la commande
                            </button>
                            <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Retour au panier
                            </a>
                        </div>

                        <div class="mt-3">
                            <p class="text-muted small">
                                <i class="fas fa-lock"></i> 
                                Vos informations sont sécurisées.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            
            function toggleZonesLivraison() {
                var isLivraison = $('input[name="TypeRetrait"]:checked').val() === 'LIVRAISON';
                $('#zonesLivraison').toggle(isLivraison);
                
                if (isLivraison) {
                    $('#ZoneId').prop('required', true);
                    updateFraisLivraison();
                } else {
                    $('#ZoneId').prop('required', false);
                    $('#fraisLivraisonText').text('0 FCFA');
                    updateTotal();
                }
            }

            
            function updateFraisLivraison() {
                var zoneId = $('#ZoneId').val();
                var frais = 0;
                
                if (zoneId) {
                    var option = $('#ZoneId option:selected');
                    frais = parseFloat(option.data('prix')) || 0;
                }
                
                $('#fraisLivraisonText').text(frais.toLocaleString() + ' FCFA');
                updateTotal();
            }

            
            function updateTotal() {
                var sousTotal = @Model.TotalCommande;
                var fraisLivraison = parseFloat($('#fraisLivraisonText').text().replace(' FCFA', '').replace(/,/g, '')) || 0;
                var total = sousTotal + fraisLivraison;
                
                $('#totalAPayerText').text(total.toLocaleString() + ' FCFA');
            }

            
            $('input[name="TypeRetrait"]').change(toggleZonesLivraison);
            $('#ZoneId').change(updateFraisLivraison);

            toggleZonesLivraison();
            updateTotal();
        });
    </script>
}