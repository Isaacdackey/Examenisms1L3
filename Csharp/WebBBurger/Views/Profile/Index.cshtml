@model WebBBurger.Models.User
@{
    ViewData["Title"] = "Mon Profil - Brasil Burger";
}
<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:48px; height:48px; background:var(--neutral-900); color:var(--white); border-radius:14px; display:grid; place-items:center;"><i class="fas fa-user-circle"></i></div>
        <div><h1 class="h4 mb-0">Mon profil</h1><p class="text-muted mb-0" style="font-size:0.88rem;">Gérez vos infos et commandes</p></div>
        <a href="@Url.Action("Edit")" class="btn btn-primary ms-auto" style="border-radius:999px;"><i class="fas fa-edit"></i> Modifier</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-2"><i class="fas fa-id-card" style="color:var(--primary)"></i> Informations personnelles</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Nom complet</label><div class="fw-bold">@Model.FullName</div></div>
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Email</label><div class="fw-bold"><i class="fas fa-envelope me-1" style="color:var(--primary)"></i> @Model.Email</div></div>
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Téléphone</label><div class="fw-bold"><i class="fas fa-phone me-1" style="color:var(--primary)"></i> @Model.Tel</div></div>
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Rôle</label><div><span class="badge" style="background:var(--neutral-900); color:var(--white); border-radius:999px;">@Model.Role</span></div></div>
                        <div class="col-12"><label class="form-label text-muted small mb-1">Adresse</label><div class="fw-bold"><i class="fas fa-map-marker-alt me-1" style="color:var(--primary)"></i> @(Model.Adresse ?? "Non renseignée") @if(!string.IsNullOrEmpty(Model.Quartier)){<span class="text-muted">(@Model.Quartier)</span>}</div></div>
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Inscription</label><div style="font-weight:600;">@Model.CreatedAt.ToString("dd/MM/yyyy")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted small mb-1">Statut</label><div>@if(Model.IsActive){<span class="badge bg-success" style="border-radius:999px;"><i class="fas fa-check-circle me-1"></i> Actif</span>}else{<span class="badge bg-danger" style="border-radius:999px;">Inactif</span>}</div></div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a href="@Url.Action("Edit")" class="btn btn-primary"><i class="fas fa-edit"></i> Modifier profil</a>
                        <a href="@Url.Action("Orders")" class="btn btn-outline-secondary" style="border-radius:999px;"><i class="fas fa-history"></i> Commandes</a>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header" style="background:var(--warning); color:var(--neutral-900);"><i class="fas fa-key me-2"></i> Changer mon mot de passe</div>
                <div class="card-body">
                    <form asp-action="ChangePassword" asp-controller="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label">Ancien mot de passe *</label><input type="password" name="OldPassword" class="form-control" required placeholder="Ancien mot de passe" /></div>
                            <div class="col-md-6"><label class="form-label">Nouveau *</label><input type="password" name="NewPassword" class="form-control" required placeholder="Nouveau" /></div>
                            <div class="col-md-6"><label class="form-label">Confirmer *</label><input type="password" name="ConfirmNewPassword" class="form-control" required placeholder="Confirmer" /></div>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 mt-3" style="background:var(--accent-gold); color:var(--neutral-900); border:none; font-weight:700; border-radius:999px;">Mettre à jour le mot de passe</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4 text-center">
                <div class="card-body">
                    <div class="display-6 fw-bold" style="color:var(--primary)">@ViewBag.OrderCount</div><p class="text-muted mb-3">Commandes passées</p>
                    <div class="h4 fw-bold text-success">@((ViewBag.TotalSpent ?? 0).ToString("N0")) FCFA</div><p class="text-muted">Total dépensé</p>
                    @if(ViewBag.LastOrderDate != null){<div class="mt-3 p-2" style="background:var(--gray-50); border-radius:12px;"><small class="text-muted">Dernière commande</small><div class="fw-bold">@(((DateTime)ViewBag.LastOrderDate).ToString("dd/MM/yyyy"))</div></div>}
                </div>
            </div>
            <div class="card">
                <div class="card-header"><i class="fas fa-bolt me-2" style="color:var(--primary)"></i> Actions rapides</div>
                <div class="card-body d-grid gap-2">
                    <a href="@Url.Action("Orders")" class="btn btn-outline-primary text-start"><i class="fas fa-receipt me-2"></i> Mes commandes</a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-success text-start"><i class="fas fa-utensils me-2"></i> Commander</a>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary text-start"><i class="fas fa-shopping-bag me-2"></i> Panier</a>
                </div>
            </div>
        </div>
    </div>
</div>
