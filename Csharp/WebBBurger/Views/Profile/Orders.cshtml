@model IEnumerable<WebBBurger.Models.Commande>
@{
    ViewData["Title"] = "Mes Commandes - Brasil Burger";
}
<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:44px; height:44px; background:var(--primary); color:var(--white); border-radius:12px; display:grid; place-items:center;"><i class="fas fa-receipt"></i></div>
        <h1 class="h4 mb-0">Mes commandes</h1>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary ms-auto" style="border-radius:999px;">← Profil</a>
    </div>
    @if (Model == null || !Model.Any()){
        <div class="card text-center py-5" style="border-style:dashed;"><div class="card-body"><i class="fas fa-shopping-bag fa-2x mb-3" style="color:var(--gray-300)"></i><h5>Aucune commande</h5><p class="text-muted">Commencez à commander.</p><a href="@Url.Action("Index", "Home")" class="btn btn-primary">Catalogue</a></div></div>
    } else {
        <div class="row g-3">@foreach(var c in Model.OrderByDescending(x=>x.CreatedAt)){
            <div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2"><strong>#BB-@c.Id</strong><span class="badge" style="@GetStatusStyle(c.Statut) border:1px solid rgba(0,0,0,0.06); border-radius:999px;">@c.StatutDisplay</span></div>
                <small class="text-muted">@c.CreatedAt.ToString("dd/MM/yyyy") • @c.TypeRetrait</small>
                <div class="fw-bold mt-2">@c.MontantTotal.ToString("N0") FCFA</div>
                <a href="@Url.Action("Details", "Order", new { id = c.Id })" class="btn btn-outline-primary btn-sm w-100 mt-3" style="border-radius:999px;">Voir détails</a>
            </div></div></div>
        }</div>
    }
</div>

@functions{
    string GetStatusStyle(string s) => s switch{
        "EN_ATTENTE" => "background:var(--primary-50); color:var(--primary-dark);",
        "VALIDEE" => "background:#eff6ff; color:#1d4ed8;",
        "ANNULEE" => "background:var(--danger-light); color:#991b1b;",
        "TERMINEE" => "background:var(--success-light); color:#166534;",
        "LIVREE" => "background:var(--success-light); color:#166534;",
        _ => "background:var(--gray-100); color:var(--gray-700);"
    };
}
