<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <meta name="description" content="Brasil Burger — burgers artisanaux, menus gourmands et compléments frais. Commandez en ligne à Dakar." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-hamburger"></i>
                <strong>BRASIL <span>BURGER</span></strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                            Accueil
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Menu
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-type="burger"><i class="fas fa-hamburger"></i> Burgers</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-type="menu"><i class="fas fa-layer-group"></i> Menus</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-type="complement"><i class="fas fa-mug-hot"></i> Compléments</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="fas fa-th-large"></i> Tout voir</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Home", "Contact")" asp-controller="Home" asp-action="Contact">
                            Contact
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link cart-btn @IsActive("Cart", "Index")" asp-controller="Cart" asp-action="Index" aria-label="Panier">
                            <i class="fas fa-shopping-bag"></i> Panier
                            @{
                                var cartItemCount = ViewBag.CartItemCount ?? 0;
                                if (TempData["CartItemCount"] != null)
                                {
                                    cartItemCount = Convert.ToInt32(TempData["CartItemCount"]);
                                    TempData.Keep("CartItemCount");
                                }
                            }
                            @if (cartItemCount > 0)
                            {
                                <span class="cart-badge pulse">@cartItemCount</span>
                            }
                        </a>
                    </li>
                    @{
                        var isAuthenticated = Context.Session.GetInt32("UserId") != null;
                        var userName = Context.Session.GetString("UserName");
                    }
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle"></i> @(userName ?? "Mon compte")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fas fa-user"></i> Mon profil</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Orders"><i class="fas fa-receipt"></i> Mes commandes</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt"></i> Déconnexion</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Account", "Login")" asp-controller="Account" asp-action="Login">
                                Connexion
                            </a>
                        </li>
                        <li class="nav-item ms-lg-1">
                            <a class="btn btn-warning" asp-controller="Account" asp-action="Register">
                                Inscription
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>


    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success fade show" role="alert">
                <i class="fas fa-check-circle mt-1"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger fade show" role="alert">
                <i class="fas fa-exclamation-triangle mt-1"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info fade show" role="alert">
                <i class="fas fa-info-circle mt-1"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning fade show" role="alert">
                <i class="fas fa-exclamation-circle mt-1"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
    </div>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5><i class="fas fa-hamburger"></i> Brasil Burger</h5>
                    <p class="mb-3" style="color:rgba(255,255,255,0.6); font-size:0.92rem; line-height:1.7;">
                        L''art du burger artisanal à Dakar. Viandes sélectionnées, pains moelleux, frites croustillantes et sauces maison. Fraîcheur et passion à chaque bouchée.
                    </p>
                    <div class="social">
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Explorer</h5>
                    <a asp-controller="Home" asp-action="Index" asp-route-type="burger">Burgers</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-type="menu">Menus</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-type="complement">Compléments</a>
                    <a asp-controller="Cart" asp-action="Index">Panier</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Contact</h5>
                    <a href="#"><i class="fas fa-map-marker-alt me-2" style="color:var(--primary)"></i> Dakar, Sénégal — Point E</a>
                    <a href="tel:+221771234567"><i class="fas fa-phone me-2" style="color:var(--primary)"></i> +221 77 123 45 67</a>
                    <a href="mailto:contact@brasilburger.sn"><i class="fas fa-envelope me-2" style="color:var(--primary)"></i> contact@brasilburger.sn</a>
                    <span style="color:rgba(255,255,255,0.5); font-size:0.85rem; display:block; margin-top:0.5rem;"><i class="fas fa-clock me-1"></i> 10h — 23h • 7j/7</span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Infos</h5>
                    <a asp-controller="Home" asp-action="Privacy">Confidentialité</a>
                    <a asp-controller="Home" asp-action="Contact">Nous contacter</a>
                    <a asp-controller="Profile" asp-action="Orders">Suivi commande</a>
                    <span style="display:inline-flex; align-items:center; gap:0.4rem; margin-top:0.75rem; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); padding:0.4rem 0.75rem; border-radius:999px; font-size:0.82rem;"><span style="width:8px; height:8px; background:var(--success); border-radius:50%; display:inline-block; box-shadow:0 0 8px rgba(22,163,74,0.6);"></span> Service ouvert</span>
                </div>
            </div>
            <hr class="mt-4 mb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2" style="font-size:0.88rem; color:rgba(255,255,255,0.5);">
                <span>&copy; @DateTime.Now.Year Brasil Burger — Tous droits réservés. Kazi OTP.</span>
                <span style="display:flex; align-items:center; gap:0.5rem;">Paiement sécurisé <i class="fas fa-lock" style="color:var(--accent-gold)"></i> Wave • Orange Money • Espèces • Carte</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(function(){
            var tooltipTriggerList = [].slice.call(document.querySelectorAll(''[data-bs-toggle="tooltip"]''));
            tooltipTriggerList.forEach(function (el) { return new bootstrap.Tooltip(el); });
        });
    </script>
</body>
</html>
@functions {
    string IsActive(string controller, string action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        return (currentController == controller && currentAction == action) ? "active" : "";
    }
}
