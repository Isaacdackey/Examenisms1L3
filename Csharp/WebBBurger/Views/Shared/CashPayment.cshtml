@model int?
@{
    ViewData["Title"] = "Paiement en espèces - Brasil Burger";
    var commandeId = Model ?? 0;
    var commande = ViewData["Commande"] as WebBBurger.Models.Commande;
    var montantTotal = ViewData["MontantTotal"] as decimal? ?? (commande?.MontantTotal ?? 11950);
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="card overflow-hidden" style="border-radius: var(--radius-xl);">
            <div class="card-header d-flex align-items-center gap-3" style="background: linear-gradient(135deg, var(--success), #15803d); color:var(--white); padding:1.5rem; border:none;">
                <div style="width:56px; height:56px; background:rgba(255,255,255,0.18); border-radius:14px; display:grid; place-items:center; font-size:1.4rem; backdrop-filter: blur(8px);"><i class="fas fa-money-bill-wave"></i></div>
                <div><h3 class="mb-0" style="color:var(--white)">Paiement en espèces</h3><p class="mb-0" style="color:rgba(255,255,255,0.85); font-size:0.9rem;">Présentez votre numéro en caisse</p></div>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-md-6 p-4">
                        <div class="text-center p-3 mb-4" style="background:var(--success-light); border:1px solid #bbf7d0; border-radius: var(--radius-md);">
                            <small class="text-muted d-block">Numéro de commande</small>
                            <div class="display-6 fw-bold" style="color:var(--success)">BB-#@commandeId</div>
                            @if(commande?.Client != null){<small class="text-muted">@commande.Client.Nom @commande.Client.Prenom</small>}
                        </div>
                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex gap-3"><span style="width:36px; height:36px; background:var(--success); color:var(--white); border-radius:50%; display:grid; place-items:center; font-weight:700; flex-shrink:0;">1</span><div><strong>Préparez le montant exact</strong><div class="text-muted" style="font-size:0.88rem;">@montantTotal.ToString("N0") FCFA</div></div></div>
                            <div class="d-flex gap-3"><span style="width:36px; height:36px; background:var(--success); color:var(--white); border-radius:50%; display:grid; place-items:center; font-weight:700; flex-shrink:0;">2</span><div><strong>Rendez-vous en caisse</strong><div class="text-muted" style="font-size:0.88rem;">Présentez BB-#@commandeId</div></div></div>
                            <div class="d-flex gap-3"><span style="width:36px; height:36px; background:var(--success); color:var(--white); border-radius:50%; display:grid; place-items:center; font-weight:700; flex-shrink:0;">3</span><div><strong>Recevez votre reçu</strong><div class="text-muted" style="font-size:0.88rem;">Conservez-le jusqu''à la livraison</div></div></div>
                        </div>
                        <div class="alert alert-warning py-2" style="font-size:0.88rem;"><i class="fas fa-exclamation-triangle me-1"></i> Paiement avant préparation. Reçu obligatoire.</div>
                    </div>
                    <div class="col-md-6 p-4" style="background:var(--gray-50); border-left:1px solid var(--gray-100);">
                        <h5 class="mb-3"><i class="fas fa-receipt me-2" style="color:var(--success)"></i> Récapitulatif</h5>
                        <div class="card mb-4"><div class="card-body d-flex justify-content-between align-items-center"><span class="fw-bold">Total à payer</span><span class="h4 mb-0" style="color:var(--success)">@montantTotal.ToString("N0") FCFA</span></div></div>
                        <form asp-action="CompleteCashPayment" asp-controller="Payment" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="commandeId" value="@commandeId" />
                            <button type="submit" class="btn btn-success btn-lg" onclick="return confirm(''Confirmez-vous avoir payé en caisse ?'')"><i class="fas fa-check-circle"></i> Confirmer le paiement</button>
                            <p class="text-muted text-center mb-0" style="font-size:0.82rem;"><i class="fas fa-lock me-1"></i> Cliquez après paiement en caisse uniquement</p>
                        </form>
                        <div class="d-grid gap-2 mt-3">
                            <a href="@Url.Action("Details", "Order", new { id = commandeId })" class="btn btn-outline-secondary" style="border-radius:999px;"><i class="fas fa-arrow-left"></i> Détails commande</a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary" style="border-radius:999px;"><i class="fas fa-home"></i> Accueil</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
