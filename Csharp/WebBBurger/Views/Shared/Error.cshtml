@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur - Brasil Burger";
}
<div class="container py-5 text-center">
    <div style="width:80px; height:80px; background:var(--danger-light); color:var(--danger); border-radius:50%; display:grid; place-items:center; margin:0 auto 1rem; font-size:2rem;"><i class="fas fa-exclamation-triangle"></i></div>
    <h1 class="h2">Oups, une erreur est survenue</h1>
    <p class="text-muted mx-auto" style="max-width:560px;">Notre équipe a été notifiée. Réessayez dans quelques instants ou retournez à l''accueil.</p>
    @if (Model.ShowRequestId){<p class="text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>}
    <div class="d-flex justify-content-center gap-2 mt-4">
        <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Accueil</a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary" style="border-radius:999px;">Retour</a>
    </div>
</div>
