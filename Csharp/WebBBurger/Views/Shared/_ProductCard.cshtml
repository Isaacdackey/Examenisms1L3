@model WebBBurger.Models.ViewModels.ProductViewModel
<div class="card product-card h-100">
    <div class="img-wrap">
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Libelle" loading="lazy" onerror="this.style.display=''none''; this.nextElementSibling.style.display=''flex''" />
        <div class="w-100 h-100 d-none align-items-center justify-content-center" style="background: linear-gradient(135deg, var(--primary-50), var(--accent-gold-light)); min-height:200px;">
            <i class="fas fa-hamburger fa-2x" style="color:var(--primary)"></i>
        </div>
        @{
            var badgeClass = Model.TypeProduct?.ToLower() == "burger" ? "badge-burger" : Model.TypeProduct?.ToLower() == "menu" ? "badge-menu" : "badge-complement";
            var icon = Model.TypeProduct switch { "BURGER" => "fa-hamburger", "MENU" => "fa-layer-group", "COMPLEMENT" => "fa-mug-hot", _ => "fa-tag" };
        }
        <span class="product-badge @badgeClass"><i class="fas @icon"></i> @Model.TypeProduct</span>
        @if (Model.TypeProduct == "MENU" && Model.ReductionPourcentage > 0)
        {
            <span class="position-absolute top-0 end-0 m-2 badge bg-danger" style="border-radius:999px; font-weight:800;">-@Model.ReductionPourcentage%</span>
        }
    </div>
    <div class="card-body">
        <h5 class="card-title">@Model.Libelle</h5>
        <p class="card-text text-muted small mb-2">
            @if (!string.IsNullOrEmpty(Model.Description) && Model.Description.Length > 90)
            {
                @Model.Description.Substring(0, 90)<text>…</text>
            }
            else
            {
                @Model.Description
            }
        </p>
        @if (Model.TypeProduct == "BURGER" && Model.Calories.HasValue)
        {
            <div class="d-flex gap-2 mb-2">
                <span class="badge" style="background:var(--gray-100); color:var(--gray-700); border:1px solid var(--gray-200); border-radius:999px;"><i class="fas fa-fire text-danger me-1"></i> @Model.Calories kcal</span>
                @if (Model.TempsPreparation.HasValue)
                {
                    <span class="badge" style="background:var(--gray-100); color:var(--gray-700); border:1px solid var(--gray-200); border-radius:999px;"><i class="fas fa-clock text-primary me-1"></i> @Model.TempsPreparation min</span>
                }
            </div>
        }
        <div class="d-flex justify-content-between align-items-end mt-2">
            <div>
                @if (Model.TypeProduct == "MENU" && Model.PrixOriginal > 0)
                {
                    <div class="price-original">@Model.PrixOriginal.ToString("N0") FCFA</div>
                    <div class="price-tag">@Model.Prix.ToString("N0") <small>FCFA</small></div>
                }
                else
                {
                    <div class="price-tag">@Model.Prix.ToString("N0") <small>FCFA</small></div>
                }
            </div>
            <span class="badge" style="background:var(--neutral-900); color:var(--white); border-radius:999px;">@Model.TypeProduct</span>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm flex-fill"><i class="fas fa-eye"></i> Détails</a>
        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-shopping-bag"></i> Ajouter</button>
        </form>
    </div>
</div>
