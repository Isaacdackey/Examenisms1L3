@model WebBBurger.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion - Brasil Burger";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <div style="width:56px; height:56px; background:var(--primary); color:var(--white); border-radius:16px; display:grid; place-items:center; margin:0 auto 0.75rem; font-size:1.4rem; box-shadow: var(--box-shadow-orange);"><i class="fas fa-hamburger"></i></div>
                <h1 class="h3" style="letter-spacing:-0.02em;">Bon retour !</h1>
                <p class="text-muted">Connectez-vous pour commander plus vite</p>
            </div>
            <div class="card auth-card">
                <div class="card-body p-4 p-md-4">
                    <form asp-action="Login" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="vous@exemple.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" id="pwd" />
                                <button class="btn btn-outline-secondary" type="button" onclick="var i=document.getElementById(''pwd''); i.type=i.type===''password''?''text'':''password''; this.querySelector(''i'').classList.toggle(''fa-eye''); this.querySelector(''i'').classList.toggle(''fa-eye-slash'')" style="border-radius:0 var(--radius-md) var(--radius-md) 0"><i class="fas fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check mb-0">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label" style="font-size:0.9rem;">Se souvenir de moi</label>
                            </div>
                            <a href="#" class="small" style="font-weight:600;">Mot de passe oublié ?</a>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-sign-in-alt"></i> Se connecter</button>
                            <a href="@Url.Action("Register")" class="btn btn-outline-secondary" style="border-radius:999px;">Créer un compte →</a>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-center text-muted mt-3" style="font-size:0.85rem;"><i class="fas fa-shield-alt me-1"></i> Connexion sécurisée • Chiffrement SSL</p>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
