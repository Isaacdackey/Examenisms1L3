@model WebBBurger.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Panier - Brasil Burger";
}
<div class="container mt-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:48px; height:48px; background:var(--neutral-900); color:var(--white); border-radius:14px; display:grid; place-items:center; font-size:1.2rem;"><i class="fas fa-shopping-bag"></i></div>
        <div>
            <h1 class="h3 mb-0" style="letter-spacing:-0.02em;">Mon panier</h1>
            <p class="text-muted mb-0" style="font-size:0.9rem;">@Model.TotalItems article(s) • Livraison estimée 30 min</p>
        </div>
        @if (Model.Items.Any())
        {
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary ms-auto d-none d-md-inline-flex" style="border-radius:999px;"><i class="fas fa-arrow-left"></i> Continuer mes achats</a>
        }
    </div>
    @if (!Model.Items.Any())
    {
        <div class="card text-center py-5" style="border-style:dashed;">
            <div class="card-body">
                <div style="width:72px; height:72px; background:var(--primary-50); color:var(--primary); border-radius:50%; display:grid; place-items:center; margin:0 auto 1rem; font-size:1.8rem;"><i class="fas fa-shopping-basket"></i></div>
                <h4>Votre panier est vide</h4>
                <p class="text-muted mx-auto" style="max-width:480px;">Ajoutez vos burgers, menus et compléments préférés et retrouvez-les ici pour commander en un clic.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2"><i class="fas fa-utensils"></i> Voir le catalogue</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Produits (@Model.TotalItems articles)</strong>
                        <form asp-action="Clear" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius:999px;" onclick="return confirm(''Vider le panier ?'')"><i class="fas fa-trash me-1"></i> Vider</button>
                        </form>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex gap-3 p-3 align-items-center" style="border-bottom:1px solid var(--gray-100);">
                                <img src="@item.ImageUrl" alt="@item.Libelle" style="width:84px; height:84px; border-radius:12px; object-fit:cover; background:var(--gray-50); flex-shrink:0;" onerror="this.style.display=''none''" />
                                <div class="flex-fill" style="min-width:0;">
                                    <div class="fw-bold" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Libelle</div>
                                    <div class="text-muted" style="font-size:0.85rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Description</div>
                                    <span class="badge mt-1" style="background:var(--gray-100); color:var(--gray-700); border:1px solid var(--gray-200); border-radius:999px; font-size:0.72rem;">@item.TypeProduct</span>
                                    <div class="d-flex align-items-center gap-2 mt-2 d-md-none">
                                        <form asp-action="Update" method="post" class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <div class="quantity-selector" style="padding:0.2rem;">
                                                <button type="button" class="qty-btn" style="width:28px; height:28px;" onclick="this.nextElementSibling.stepDown(); this.nextElementSibling.dispatchEvent(new Event(''change''))">−</button>
                                                <input type="number" name="quantity" value="@item.Quantite" min="1" max="20" class="border-0 bg-transparent text-center" style="width:40px; font-weight:700;" onchange="this.form.submit()">
                                                <button type="button" class="qty-btn" style="width:28px; height:28px;" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.dispatchEvent(new Event(''change''))">+</button>
                                            </div>
                                        </form>
                                        <span class="ms-auto fw-bold" style="color:var(--neutral-900)">@item.SousTotal.ToString("N0") FCFA</span>
                                    </div>
                                </div>
                                <div class="d-none d-md-flex flex-column align-items-end gap-2" style="min-width:140px;">
                                    <form asp-action="Update" method="post" class="d-flex align-items-center gap-1">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="number" name="quantity" value="@item.Quantite" min="1" max="20" class="form-control text-center" style="width:64px; border-radius:999px; font-weight:700;">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" style="border-radius:999px;" title="Mettre à jour"><i class="fas fa-sync"></i></button>
                                    </form>
                                    <div class="fw-bold" style="color:var(--neutral-900)">@item.SousTotal.ToString("N0") FCFA</div>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm" style="background:var(--danger-light); color:var(--danger); border-radius:999px; font-weight:600;"><i class="fas fa-trash me-1"></i> Supprimer</button>
                                    </form>
                                </div>
                                <form asp-action="Remove" method="post" class="d-md-none">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm" style="background:var(--danger-light); color:var(--danger); border-radius:50%; width:36px; height:36px; display:grid; place-items:center;"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h5 class="mb-3"><i class="fas fa-receipt me-2" style="color:var(--primary)"></i> Récapitulatif</h5>
                    <div class="summary-line"><span>Sous-total</span><strong>@Model.Total.ToString("N0") FCFA</strong></div>
                    <div class="summary-line"><span>Livraison</span><span class="text-muted">À calculer</span></div>
                    <div class="summary-line total"><span>Total</span><span>@Model.Total.ToString("N0") FCFA</span></div>
                    <div class="d-grid gap-2 mt-4">
                        <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg"><i class="fas fa-lock"></i> Commander</a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary" style="border-radius:999px;"><i class="fas fa-utensils"></i> Continuer mes achats</a>
                    </div>
                    <p class="text-muted text-center mt-3 mb-0" style="font-size:0.82rem;"><i class="fas fa-shield-alt me-1"></i> Paiement 100% sécurisé</p>
                    <div class="d-flex justify-content-center gap-2 mt-2" style="font-size:0.8rem; color:var(--gray-500);"><span>Wave</span>•<span>Orange Money</span>•<span>Carte</span>•<span>Espèces</span></div>
                </div>
            </div>
        </div>
    }
</div>
