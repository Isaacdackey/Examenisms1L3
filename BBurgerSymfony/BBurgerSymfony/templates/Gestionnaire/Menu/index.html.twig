{% extends 'base.html.twig' %}

{% block title %}Gestion des Menus - BB.Resto{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3"><i class="bi bi-menu-button-wide"></i> Gestion des Menus</h1>
    <a href="{{ path('gestionnaire_menu_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau menu
    </a>
</div>


<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Composition</th>
                        <th>Prix</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for menu in menus %}
                    <tr>
                        <td>
                            {% if menu.cloudinaryUrl %}
                                <img src="{{ menu.cloudinaryUrl }}" width="50" height="50" class="rounded" style="object-fit: cover;">
                            {% else %}
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="bi bi-menu-button-wide text-muted"></i>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <strong>{{ menu.libelle }}</strong>
                            {% if menu.description %}
                                <br><small class="text-muted">{{ menu.description|slice(0, 50) }}...</small>
                            {% endif %}
                        </td>
                        <td>
                            <small>
                                <strong>Burger:</strong> {{ menu.burger.libelle }}<br>
                                <strong>Boisson:</strong> {{ menu.boisson.libelle }}<br>
                                <strong>Frites:</strong> {{ menu.frites.libelle }}
                            </small>
                        </td>
                        <td>
                            <strong>{{ menu.prix|number_format(0, ',', ' ') }} FCFA</strong>
                            <br>
                            <small class="text-success">
                                <i class="bi bi-info-circle"></i> -{{ menu.promotion|default(0) }}%
                            </small>
                        </td>
                        <td>
                            {% if menu.isArchived %}
                                <span class="badge bg-danger">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('gestionnaire_menu_edit', {id: menu.id}) }}" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                
                                {% if menu.isArchived %}
                                    <form method="post" action="{{ path('gestionnaire_menu_restore', {id: menu.id}) }}" 
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ menu.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('gestionnaire_menu_archive', {id: menu.id}) }}" 
                                          class="d-inline" 
                                          onsubmit="return confirm('Archiver ce menu ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ menu.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="bi bi-menu-button-wide display-6 text-muted"></i>
                            <p class="mt-3 text-muted">Aucun menu trouvé</p>
                            <a href="{{ path('gestionnaire_menu_new') }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Créer votre premier menu
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}