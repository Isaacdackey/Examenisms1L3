{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes - BB.Resto{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3"><i class="bi bi-cart-check"></i> Gestion des commandes</h1>
</div>


<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Statut</label>
                <select name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    <option value="EN_ATTENTE" {% if statutFilter == 'EN_ATTENTE' %}selected{% endif %}>En attente</option>
                    <option value="VALIDEE" {% if statutFilter == 'VALIDEE' %}selected{% endif %}>Validée</option>
                    <option value="EN_PREPARATION" {% if statutFilter == 'EN_PREPARATION' %}selected{% endif %}>En préparation</option>
                    <option value="PRETE" {% if statutFilter == 'PRETE' %}selected{% endif %}>Prête</option>
                    <option value="EN_LIVRAISON" {% if statutFilter == 'EN_LIVRAISON' %}selected{% endif %}>En livraison</option>
                    <option value="LIVREE" {% if statutFilter == 'LIVREE' %}selected{% endif %}>Livrée</option>
                    <option value="TERMINEE" {% if statutFilter == 'TERMINEE' %}selected{% endif %}>Terminée</option>
                    <option value="ANNULEE" {% if statutFilter == 'ANNULEE' %}selected{% endif %}>Annulée</option>
                </select>
            </div>
            
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" value="{{ dateFilter }}">
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Client</label>
                <select name="client" class="form-select">
                    <option value="">Tous les clients</option>
                    {% for client in clients %}
                        <option value="{{ client.id }}" {% if clientFilter == client.id %}selected{% endif %}>
                            {{ client.fullName }} - {{ client.email }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Produit (burger/menu)</label>
                <select name="produit" class="form-select">
                    <option value="">Tous les produits</option>
                    {% for produit in produits %}
                        <option value="{{ produit.id }}" {% if produitFilter == produit.id %}selected{% endif %}>
                            {{ produit.libelle }} ({{ produit.getType() }})
                        </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter"></i> Filtrer
                </button>
            </div>
            
            
            <input type="hidden" name="limit" value="{{ limit }}">
            <input type="hidden" name="page" value="1">
        </form>
    </div>
</div>


<div class="card">
    <div class="card-body">
        {% if commandes is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Aucune commande trouvée avec ces critères.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Numéro</th>
                            <th>Client</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Type retrait</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td>
                                <strong>{{ commande.numero }}</strong>
                            </td>
                            <td>
                                <div>
                                    <strong>{{ commande.user.fullName }}</strong>
                                    <br>
                                    <small class="text-muted">
                                        <i class="bi bi-telephone"></i> {{ commande.user.tel }}
                                    </small>
                                </div>
                            </td>
                            <td>
                                <strong>{{ commande.formattedMontant }}</strong>
                            </td>
                            <td>
                                <span class="badge 
                                    {% if commande.statut == 'EN_ATTENTE' %}bg-warning text-dark
                                    {% elseif commande.statut == 'VALIDEE' %}bg-info
                                    {% elseif commande.statut == 'EN_PREPARATION' %}bg-primary
                                    {% elseif commande.statut == 'PRETE' %}bg-success
                                    {% elseif commande.statut == 'EN_LIVRAISON' %}bg-dark
                                    {% elseif commande.statut == 'LIVREE' %}bg-success
                                    {% elseif commande.statut == 'TERMINEE' %}bg-secondary
                                    {% elseif commande.statut == 'ANNULEE' %}bg-danger
                                    {% endif %}">
                                    {{ commande.statut }}
                                </span>
                            </td>
                            <td>
                                <small>
                                    {% if commande.typeRetrait == 'LIVRAISON' %}
                                        <i class="bi bi-truck"></i> Livraison
                                    {% elseif commande.typeRetrait == 'A_EMPORTER' %}
                                        <i class="bi bi-bag"></i> À emporter
                                    {% else %}
                                        <i class="bi bi-shop"></i> Sur place
                                    {% endif %}
                                </small>
                            </td>
                            <td>
                                {{ commande.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('gestionnaire_commande_details', {id: commande.id}) }}" 
                                       class="btn btn-sm btn-outline-primary" title="Voir détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    
                                    {% if commande.statut == 'EN_ATTENTE' %}
                                        <form method="post" action="{{ path('gestionnaire_commande_valider', {id: commande.id}) }}" 
                                              class="d-inline" onsubmit="return confirm('Valider cette commande ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ commande.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Valider">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    
                                    {% if commande.statut in ['EN_ATTENTE', 'VALIDEE'] %}
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalAnnuler{{ commande.id }}"
                                                title="Annuler">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    {% endif %}
                                    
                                    {% if commande.statut in ['VALIDEE', 'EN_PREPARATION'] %}
                                        <form method="post" action="{{ path('gestionnaire_commande_prete', {id: commande.id}) }}" 
                                              class="d-inline" onsubmit="return confirm('Marquer comme prête ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('prete' ~ commande.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-info" title="Marquer prête">
                                                <i class="bi bi-box-seam"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                                
                                
                                <div class="modal fade" id="modalAnnuler{{ commande.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form method="post" action="{{ path('gestionnaire_commande_annuler', {id: commande.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ commande.id) }}">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Annuler la commande</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Voulez-vous vraiment annuler la commande <strong>{{ commande.numero }}</strong> ?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label">Raison de l'annulation</label>
                                                        <textarea name="raison" class="form-control" rows="3" 
                                                                  placeholder="Optionnel"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                                    <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                {% if commande.statut in ['PRETE', 'EN_LIVRAISON'] %}
                                    <form method="post" action="{{ path('gestionnaire_commande_terminer', {id: commande.id}) }}"
                                        class="d-inline" onsubmit="return confirm('Marquer comme terminée ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('terminer' ~ commande.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Terminer">
                                            <i class="bi bi-check-all"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            
            {% if pagesCount > 1 %}
            <nav aria-label="Navigation des pages" class="mt-4">
                <ul class="pagination justify-content-center mb-3">
                   
                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                        <a class="page-link" 
                           href="{{ path('gestionnaire_commandes', app.request.query.all|merge({page: currentPage - 1})) }}">
                            &laquo; Précédent
                        </a>
                    </li>
                    
                  
                    {% if currentPage > 3 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('gestionnaire_commandes', app.request.query.all|merge({page: 1})) }}">
                                1
                            </a>
                        </li>
                        {% if currentPage > 4 %}
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        {% endif %}
                    {% endif %}
                    
                    
                    {% for page in range(max(1, currentPage - 2), min(pagesCount, currentPage + 2)) %}
                        <li class="page-item {% if page == currentPage %}active{% endif %}">
                            <a class="page-link" 
                               href="{{ path('gestionnaire_commandes', app.request.query.all|merge({page: page})) }}">
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}
                    
                    
                    {% if currentPage < pagesCount - 2 %}
                        {% if currentPage < pagesCount - 3 %}
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        {% endif %}
                        <li class="page-item">
                            <a class="page-link" 
                               href="{{ path('gestionnaire_commandes', app.request.query.all|merge({page: pagesCount})) }}">
                                {{ pagesCount }}
                            </a>
                        </li>
                    {% endif %}
                    
                    
                    <li class="page-item {% if currentPage == pagesCount %}disabled{% endif %}">
                        <a class="page-link" 
                           href="{{ path('gestionnaire_commandes', app.request.query.all|merge({page: currentPage + 1})) }}">
                            Suivant &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
            {% endif %}
            
            
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <div>
                    <span class="text-muted">
                        <i class="bi bi-info-circle"></i> 
                        Affichage de <strong>{{ commandes|length }}</strong> commande(s) 
                        sur <strong>{{ totalItems }}</strong> au total
                        {% if pagesCount > 1 %}
                            (Page {{ currentPage }} sur {{ pagesCount }})
                        {% endif %}
                    </span>
                </div>
                
            
                <div class="d-flex align-items-center">
                    <span class="me-2 text-muted">Afficher :</span>
                    <div class="btn-group btn-group-sm">
                        {% for limitOption in [10, 15, 25, 50] %}
                            <a href="{{ path('gestionnaire_commandes', app.request.query.all|merge({limit: limitOption, page: 1})) }}" 
                               class="btn btn-outline-secondary {% if limit == limitOption %}active{% endif %}">
                                {{ limitOption }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>


<style>
.pagination {
    margin-bottom: 0;
}
.page-item.active .page-link {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: white;
}
.page-link {
    color: #0d6efd;
}
.page-item.disabled .page-link {
    color: #6c757d;
}
.btn-group .btn-outline-secondary.active {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: white;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.querySelector('form[method="get"]');
    if (filterForm) {
        const filterElements = filterForm.querySelectorAll('select, input[type="date"]');
        
        filterElements.forEach(element => {
            element.addEventListener('change', function() {
                const pageInput = filterForm.querySelector('input[name="page"]');
                if (pageInput) {
                    pageInput.value = 1;
                }
            });
        });
    }
    
    
    const actionForms = document.querySelectorAll('form[onsubmit*="confirm"]');
    actionForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            const message = this.getAttribute('onsubmit').match(/return confirm\('([^']+)'\)/);
            if (message && !confirm(message[1])) {
                e.preventDefault();
            }
        });
    });
});
</script>
{% endblock %}