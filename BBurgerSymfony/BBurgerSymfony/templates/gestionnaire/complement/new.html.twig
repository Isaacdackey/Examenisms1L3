{% extends 'base.html.twig' %}

{% block title %}Nouveau Complément - BB.Resto{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .form-label.required:after {
        content: " *";
        color: #dc3545;
    }
</style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h1 class="h4 mb-0">
                        <i class="bi bi-plus-circle"></i> Créer un nouveau complément
                    </h1>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                   
                    <div class="row mb-3">
                        <div class="col-md-8">
                            {{ form_label(form.libelle, 'Nom du complément', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Frites Maison, Coca-Cola 50cl'}}) }}
                            {{ form_errors(form.libelle) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.prix, 'Prix (FCFA)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 1000'}}) }}
                            {{ form_errors(form.prix) }}
                        </div>
                    </div>

                    
                    <div class="mb-3">
                        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Description détaillée du complément...'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.typeComplement, 'Type de complément', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.typeComplement, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.typeComplement) }}
                            <div class="form-text">
                                Sélectionnez le type de complément
                            </div>
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.volume, 'Volume/Taille', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.volume, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.volume) }}
                            <div class="form-text">
                                Optionnel - pour les boissons ou portions
                            </div>
                        </div>
                    </div>

                    
                    <div class="mb-3">
                        {{ form_label(form.imageFile, 'Image du complément', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.imageFile) }}
                        <div class="form-text">
                            Format accepté: JPG, PNG, WebP. Taille max: 2MB.
                        </div>
                    </div>

                    
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('gestionnaire_complement_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Créer le complément
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}